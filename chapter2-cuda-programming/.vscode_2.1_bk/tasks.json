{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "bear make",
            "type": "shell",
            "command": "bear",
            "args": [
                "--",
                "make",
                "-j8"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "bear make clean",
            "type": "shell",
            "command": "bear",
            "args": [
                "--",
                "make",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
        },
        {
            "label": "bear rebuild",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "bear -- make clean && bear -- make -j8"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
