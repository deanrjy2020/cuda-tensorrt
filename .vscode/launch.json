{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cuda (WSL Debug)",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/chapter2-cuda-programming/${input:cudaSample}/build/${input:cudaSample}",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/chapter2-cuda-programming/${input:cudaSample}",
            "environment": [],
            "debuggerPath": "/usr/local/cuda/bin/cuda-gdb"
        },
        {
            "name": "cuda (MSVC Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/chapter2-cuda-programming/${input:cudaSample}/build/${input:cudaSample}.exe",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/chapter2-cuda-programming/${input:cudaSample}",
            "environment": [],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "cudaSample",
            "type": "pickString",
            "description": "Select a sample with run.sh (build before debugging)",
            "options": [
                "2.1-dim-and-index"
            ],
            "default": "2.1-dim-and-index"
        }
    ]
}
